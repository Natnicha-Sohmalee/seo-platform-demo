# Copy to .env.local and replace placeholders. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server only: use the project's Supabase secret key, not its Project ID.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

CRAWLER_API_URL=http://127.0.0.1:8787
# Must match CRAWLER_API_KEY in worker/.env.
CRAWLER_API_KEY=REPLACE_WITH_THE_SAME_RANDOM_SECRET_IN_BOTH_FILES

AI_PROVIDER=typhoon
TYPHOON_API_KEY=YOUR_TYPHOON_API_KEY
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# Optional alternative: set AI_PROVIDER=gemini and fill these two values.
# No automatic fallback between providers.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=YOUR_AVAILABLE_GEMINI_MODEL_ID
